{
  "name": "securealy-monorepo",
  "private": true,
  "version": "0.1.2",
  "description": "Securealy: launch grader for apps built with AI tools",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/checks",
    "packages/core",
    "packages/cli",
    "packages/mcp",
    "packages/action"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "pretest": "npm run build",
    "test": "vitest run",
    "fixtures": "node packages/core/test/tools/make-fixtures.mjs",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b packages/core packages/cli packages/mcp",
    "sweep": "node scripts/sweep.mjs",
    "smoke": "npm run smoke --workspace packages/mcp"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
