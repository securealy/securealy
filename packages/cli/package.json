{
  "name": "securealy",
  "version": "0.1.3",
  "description": "Grade a freshly launched app the way an attacker and a customer would see it",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "securealy": "./dist/bin.js"
  },
  "exports": {
    "./record": {
      "types": "./dist/record.d.ts",
      "import": "./dist/record.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
